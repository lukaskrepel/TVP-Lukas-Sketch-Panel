// bake_camera.grg
//
// Bakes the current camera transform into all layers of the current clip,
// then resets the camera to its default position (centered, scale 1.0, no rotation).
//
// Workflow:
//   1. Draw on your layers as normal.
//   2. Set the TVPaint camera to your desired reframe (pan, zoom, angle).
//   3. Run this script.
//   4. Every layer's pixel data is transformed to match the camera view.
//   5. Camera is reset to default so it looks identical, but without a camera offset.
//
// Supports: translation (pan X/Y), scale (zoom), and rotation.
// Works with both static (single keyframe) and animated camera paths.
//
// IMPORTANT – for scale/rotation baking the script uses the cut-brush stamp method:
//   it captures each layer image as a custom brush, clears the canvas, then stamps
//   the brush at the mathematically correct position/scale/angle.
//   Pure translation uses tv_panning for pixel-accurate (integer) shifting.

// ---------------------------------------------------------------
// Open undo stack so the whole operation is one undo step
// ---------------------------------------------------------------
tv_UndoOpenStack

// ---------------------------------------------------------------
// 1. Read canvas dimensions
// ---------------------------------------------------------------
tv_getwidth
ProjWidth = result
tv_getheight
ProjHeight = result
CenterX = ProjWidth / 2
CenterY = ProjHeight / 2

// ---------------------------------------------------------------
// 2. Read camera keyframes and clip frame range
// ---------------------------------------------------------------
tv_cameraenumpoints 0
IF CMP(result, "none") == 1
    tv_UndoCloseStack "Bake Camera"
    tv_warn "No camera keyframe found. Nothing to bake."
    EXIT
END
PARSE result CamX CamY CamAngle CamScale

// Check if the camera path is animated (more than one keyframe)
tv_cameraenumpoints 1
IF CMP(result, "none") == 1
    IsAnimated = 0
ELSE
    IsAnimated = 1
END

// Get clip frame range for interpolation (needed for animated cameras)
tv_clipinfo
PARSE result d d d d d d d d d d d ClipFirstFrame d ClipLastFrame d ClipFrameCount
ClipLength = ClipLastFrame - ClipFirstFrame

// ---------------------------------------------------------------
// 3. Abort early if camera is already at the identity/default
//    (only meaningful for static cameras; animated cameras always proceed)
// ---------------------------------------------------------------
IF CMP(IsAnimated, 0) == 1
    ScaleDiff = CamScale - 1.0
    IF ScaleDiff < 0
        ScaleDiff = 0 - ScaleDiff
    END

    IsDefault = 1
    IF CamX > 0.5
        IsDefault = 0
    END
    IF CamX < -0.5
        IsDefault = 0
    END
    IF CamY > 0.5
        IsDefault = 0
    END
    IF CamY < -0.5
        IsDefault = 0
    END
    IF CamAngle > 0.1
        IsDefault = 0
    END
    IF CamAngle < -0.1
        IsDefault = 0
    END
    IF ScaleDiff > 0.001
        IsDefault = 0
    END

    IF CMP(IsDefault, 1) == 1
        tv_UndoCloseStack "Bake Camera"
        tv_warn "Camera is already at the default position. Nothing to bake."
        EXIT
    END
END

// ---------------------------------------------------------------
// 4. Confirm with the user
// ---------------------------------------------------------------
tv_request "Bake camera into all layers of the current clip?|OK|Cancel"
IF CMP(result, 1) == 0
    tv_UndoCloseStack "Bake Camera"
    EXIT
END

// ---------------------------------------------------------------
// 5. Save current state so we can restore it afterwards
// ---------------------------------------------------------------
tv_layercurrentid
OrigLayerID = result
tv_layergetimage
OrigFrame = result
tv_getdrawmode
OrigDrawMode = result

tv_lockdisplay "Baking camera..."

// ---------------------------------------------------------------
// 6. Choose transform strategy
//
//    For static cameras (single keyframe), parameters are pre-computed.
//    For animated cameras, parameters are computed per-frame inside the loop
//    using tv_camerainterpolation.
//
//    The brush stamp method (used for scale/rotation):
//      1. Scale the brush to (W/camScale) × (H/camScale).
//      2. Set the handle at the camera look-at point, scaled by 1/camScale.
//      3. Set brush rotation to -camAngle (rotates around the handle).
//         Use "Angle" keyword, not "rotate" (different brush parameter!).
//      4. Stamp the handle at canvas centre.
//      All set in one tv_brushrestore call to prevent values being reset.
// ---------------------------------------------------------------

// Pre-compute static camera parameters (used when IsAnimated == 0)
IF CMP(IsAnimated, 0) == 1
    UseSimpleTranslate = 1
    ScaleDiff = CamScale - 1.0
    IF ScaleDiff < 0
        ScaleDiff = 0 - ScaleDiff
    END
    IF ScaleDiff > 0.001
        UseSimpleTranslate = 0
    END
    IF CamAngle > 0.1
        UseSimpleTranslate = 0
    END
    IF CamAngle < -0.1
        UseSimpleTranslate = 0
    END

    PanX = CenterX - CamX
    PanY = CenterY - CamY
    NewW = ProjWidth / CamScale
    NewH = ProjHeight / CamScale
    NegAngle = 0 - CamAngle
    HandleX = CamX / CamScale
    HandleY = CamY / CamScale
END



// ---------------------------------------------------------------
// 7. Iterate over all layers in the current clip
// ---------------------------------------------------------------
LayerPos = 0
LayerRun = 1


WHILE LayerRun
    tv_layergetid LayerPos
    LayerID = result

    IF CMP(LayerID, "NONE") == 1
        LayerRun = 0
    ELSE
        tv_layerinfo LayerID
        PARSE result d d d LayerName LayerType LayerStart LayerEnd d d d

        // Make this layer active
        tv_layerset LayerID

        // For animated cameras, break all exposure holds FIRST so every
        // frame has its own unique image before any pixels are changed.
        IF CMP(IsAnimated, 1) == 1
            Frame = LayerStart
            WHILE Frame <= LayerEnd
                tv_exposureinfo Frame
                IF CMP(result, "head") == 0
                    tv_exposurebreak Frame
                END
                Frame = Frame + 1
            END
        END

        // Now iterate frames and transform pixels.
        // For animated cameras every frame is processed (all are now heads).
        // For static cameras only original head frames are processed.
        Frame = LayerStart
        WHILE Frame <= LayerEnd

            tv_exposureinfo Frame
            IsHead = 0
            IF CMP(result, "head") == 1
                IsHead = 1
            END

            DoProcess = 0
            IF CMP(IsAnimated, 0) == 1
                IF CMP(IsHead, 1) == 1
                    DoProcess = 1
                END
            ELSE
                DoProcess = 1
            END

            IF CMP(DoProcess, 1) == 1

                // Navigate the clip to this frame
                tv_layerimage Frame

                // For animated cameras, compute per-frame camera state
                IF CMP(IsAnimated, 1) == 1
                    IF CMP(ClipLength, 0) == 1
                        CamT = 0
                    ELSE
                        CamT = (Frame - ClipFirstFrame) / ClipLength
                    END
                    tv_camerainterpolation CamT
                    PARSE result CamX CamY CamAngle CamScale

                    // Decide method per-frame
                    UseSimpleTranslate = 1
                    ScaleDiff = CamScale - 1.0
                    IF ScaleDiff < 0
                        ScaleDiff = 0 - ScaleDiff
                    END
                    IF ScaleDiff > 0.001
                        UseSimpleTranslate = 0
                    END
                    IF CamAngle > 0.1
                        UseSimpleTranslate = 0
                    END
                    IF CamAngle < -0.1
                        UseSimpleTranslate = 0
                    END

                    PanX = CenterX - CamX
                    PanY = CenterY - CamY
                    NewW = ProjWidth / CamScale
                    NewH = ProjHeight / CamScale
                    NegAngle = 0 - CamAngle
                    HandleX = CamX / CamScale
                    HandleY = CamY / CamScale
                END

                // Clear any active selection so the FX applies to the whole image
                tv_selectionmask "action" "clear"

                IF CMP(UseSimpleTranslate, 1) == 1
                    // ---- TRANSLATION ONLY (clean integer pixel shift) ----

                    // THIS WORKS!
                    tv_panning PanX PanY 0 2

                ELSE
                    // ---- SCALE / ROTATION (brush stamp method) ----

                    // Step 1: Copy the full canvas into the custom brush, then clear it.
                    tv_brushcut 0 0 ProjWidth ProjHeight 0 0 0 0
                    tv_clear

                    // Step 2: Scale the brush to the inverse camera zoom.
                    tv_brushstretch NewW NewH

                    // Step 3: Set handle at camera look-at point (scaled coordinates)
                    //         and rotate by the inverse camera angle, in one call.
                    //         "Angle" is the correct keyword for custom brush rotation
                    //         (not "rotate", which is a different brush parameter).
                    tv_brushrestore Handle HandleX HandleY Angle NegAngle SubPixel 2

                    // Step 4: Stamp with the handle (= camera look-at) at canvas centre.
                    tv_setdrawmode "color"
                    tv_dot CenterX CenterY 0
                END
            END

            Frame = Frame + 1
        END

        LayerPos = LayerPos + 1
    END
END

// ---------------------------------------------------------------
// 8. Restore original state
// ---------------------------------------------------------------
tv_layerset OrigLayerID
tv_layerimage OrigFrame
tv_setdrawmode OrigDrawMode

// ---------------------------------------------------------------
// 9. Reset camera to the identity/default position
//    Remove all existing keyframes, then set a single default one
//    at canvas centre, no angle, scale 1.0
// ---------------------------------------------------------------
CamKeyRun = 1
WHILE CamKeyRun
    tv_cameraenumpoints 0
    IF CMP(result, "none") == 1
        CamKeyRun = 0
    ELSE
        tv_cameraremovepoint 0
    END
END
tv_camerasetpoint 0 CenterX CenterY 0 1

tv_unlockdisplay
tv_UndoCloseStack "Bake Camera"
tv_warn "Camera baked! All layers transformed. Camera reset to default."
